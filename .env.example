# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
SECRET_KEY=change-me-to-a-long-random-string
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=doctor_appointment_db
# Used only by automated tests (a separate database that the tests re-create)
TEST_DB_NAME=doctor_appointment_test
# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0
