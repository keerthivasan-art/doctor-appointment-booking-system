digraph ER {
  rankdir=LR; fontname="Helvetica"; nodesep=0.8; ranksep=1.6;
  node [shape=plain fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=11];
  DOCTORS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
    <TR><TD COLSPAN="3" BGCOLOR="#12326b"><FONT COLOR="white"><B>DOCTORS</B></FONT></TD></TR>
    <TR><TD>PK</TD><TD ALIGN="LEFT">doctor_id</TD><TD PORT="id" ALIGN="LEFT">INT UNSIGNED, AUTO_INCREMENT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">specialization</TD><TD ALIGN="LEFT">VARCHAR(80) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">qualification</TD><TD ALIGN="LEFT">VARCHAR(120) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">consultation_fee</TD><TD ALIGN="LEFT">DECIMAL(8,2), CHECK &gt;= 0</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">TINYINT(1) DEFAULT 1</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
  </TABLE>>];
  APPOINTMENTS [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
    <TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white"><B>APPOINTMENTS</B></FONT></TD></TR>
    <TR><TD>PK</TD><TD ALIGN="LEFT">appointment_id</TD><TD ALIGN="LEFT">INT UNSIGNED, AUTO_INCREMENT</TD></TR>
    <TR><TD PORT="fk">FK</TD><TD ALIGN="LEFT">doctor_id</TD><TD ALIGN="LEFT">INT UNSIGNED NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">patient_name</TD><TD ALIGN="LEFT">VARCHAR(100) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">patient_email</TD><TD ALIGN="LEFT">VARCHAR(120) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">patient_phone</TD><TD ALIGN="LEFT">VARCHAR(10), CHECK regex</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">appointment_date</TD><TD ALIGN="LEFT">DATE NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">appointment_time</TD><TD ALIGN="LEFT">TIME NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">VARCHAR(500) NOT NULL</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM(Booked, Completed, Cancelled)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">slot_key</TD><TD ALIGN="LEFT">generated, NULL when Cancelled</TD></TR>
  </TABLE>>];
  DOCTORS:id:e -> APPOINTMENTS:fk:w [dir=both arrowtail=tee arrowhead=crow label="  1 : N  (receives)  " labeldistance=2];
}
